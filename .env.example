# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key (required for menu scraper writes)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI (optional — enables comment moderation)
OPENAI_API_KEY=your-openai-key

# Vercel Cron secret (optional — only needed if using Vercel cron endpoint)
CRON_SECRET=your-cron-secret

# GitHub PAT (optional — only needed if using Vercel cron → GitHub Action trigger)
GITHUB_PAT=your-github-pat
